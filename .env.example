# Crawllex env template (committed). Copy to `.env.local` for development.
# Production uses `.env.production.local` (gitignored) + Hostinger env — same keys,
# same shared secrets; only MONGODB_URI and APP_URL / FRONTEND_URL differ.
#
# Files we keep (only these three):
#   .env.example              ← this file (template)
#   .env.local                ← local / development  → npm run dev | npm run seed
#   .env.production.local     ← production           → npm run dev:prod | npm run seed:prod
#
# Switch on your machine:
#   npm run dev       → local DB
#   npm run dev:prod  → production DB (careful — real data)
#   npm run seed      → seed local
#   npm run seed:prod → seed production
# MongoDB
# Local example: mongodb://127.0.0.1:27017/seo-dashboard
# Atlas SRV: mongodb+srv://USER:PASS@cluster.mongodb.net/seo-dashboard?retryWrites=true&w=majority
# Atlas DIRECT (Windows querySrv ECONNREFUSED — copy from Atlas Connect → Drivers → Standard):
# MONGODB_URI=mongodb://USER:PASS@host1:27017,host2:27017,host3:27017/seo-dashboard?ssl=true&replicaSet=...&authSource=admin&retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/seo-dashboard

# App
APP_NAME=Crawllex
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
APP_KEY=base64:changeme-generate-with-openssl-rand-base64-32

# Auth
BCRYPT_ROUNDS=12
SUPER_ADMIN_EMAIL=admin@crawllex.com
SUPER_ADMIN_PASSWORD=changeme

PASSWORD_RESET_EXPIRE=60
PASSWORD_RESET_THROTTLE=60
EMAIL_VERIFICATION_EXPIRE=60

# Mail — Zoho SMTP (see doc/mail.md)
# MAIL_MAILER=log skips SMTP and logs payloads (incl. html). smtp requires host + credentials.
# APP_URL above must be reachable by recipients so /crawllex-dark.png loads in HTML mail.
MAIL_MAILER=smtp
MAIL_HOST=smtp.zoho.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=admin@crawllex.com
MAIL_FROM_NAME=Crawllex

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=seo-dashboard
R2_PUBLIC_BASE_URL=

# Cron
CRON_SECRET=

# Google Service Account (Module 8 — GSC/GA4 analytics; NOT login)
# Local: PEM with literal \n (quoted in .env). Hostinger: base64 of the full PEM (no quotes).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Google OAuth (sign-in / sign-up — Web application client)
# Create under APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match Authorized redirect URIs exactly (local example):
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Assistant AI (Gemini, read-only tools). Off by default; NLP answers when off or failing.
# Free tier: prompts may be used by Google to improve products. Never send lead PII (tools return counts only).
ASSISTANT_AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
